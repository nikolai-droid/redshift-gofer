# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_bot_token_here

# JSON array mapping source channels to destination channels
# Example: [{"source":"123","destination":"456"},{"source":"789","destination":"012"}]
MIGRATION_MAPPINGS=[]

# Delay between API calls in milliseconds (default: 1000)
MIGRATION_DELAY_MS=1000

# Number of messages to fetch per request (default: 50, max: 100)
MIGRATION_BATCH_SIZE=50

# Set to "true" to preview without sending (recommended first run)
DRY_RUN=true

# Skip messages that already exist in destination
SKIP_EXISTING=false

# Max messages per channel (0 = all)
MAX_MESSAGES_PER_CHANNEL=0

# --- Bot ---
# Application ID from Discord Developer Portal (General Information)
DISCORD_APP_ID=

# Optional: guild to register /announce in. Blank = every guild the bot is in.
DISCORD_GUILD_ID=
